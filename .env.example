# --- ElevenLabs (required for voice; text mode works without it) ---
ELEVENLABS_API_KEY=
# Pick a voice id from https://elevenlabs.io/app/voice-library (or your own clone)
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# --- Claude Code CLI (uses your normal `claude` login / subscription) ---
# Leave blank to auto-detect. On Windows npm installs this resolves to
# <npm prefix>/node_modules/@anthropic-ai/claude-code/bin/claude.exe
CLAUDE_BIN=
CLAUDE_MODEL=sonnet
# Optional: low | medium | high. Lower = snappier replies.
CLAUDE_EFFORT=low

PORT=5178
